# Copia este archivo como .env o ejecuta scripts/configure-env.ps1.
SNOWFLAKE_ACCOUNT=TODO_ORG-ACCOUNT
SNOWFLAKE_USER=TODO_USER
SNOWFLAKE_PASSWORD=TODO_PASSWORD
SNOWFLAKE_ROLE=NYC_TAXI_ROLE
SNOWFLAKE_WAREHOUSE=NYC_TAXI_WH
SNOWFLAKE_DATABASE=NYC_TAXI_DB

# Los 20 meses exigidos por el laboratorio.
NYC_TAXI_PERIODS=2025-01,2025-02,2025-03,2025-04,2025-05,2025-06,2025-07,2025-08,2025-09,2025-10,2025-11,2025-12,2026-01,2026-02,2026-03,2026-04,2026-05,2026-06,2026-07,2026-08

# true = aborta si TLC todavía no publicó algún mes. No permite una entrega incompleta.
FAIL_ON_MISSING=true

# true = dbt exige los 20 meses; false = modo demostración parcial.
ENFORCE_20_PERIODS=true
